APP_NAME=BizFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontend SPA origin (CORS + Sanctum cookies)
# Use localhost (not 127.0.0.1) so business subdomains work: http://slug.localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_ROOT_DOMAIN=localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=business_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave empty for local SPA via Vite proxy (required for 127.0.0.1)
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bizflow.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum SPA cookie auth
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,*.localhost,*.localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:18080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Stripe — required for Pro/Business (use Test mode keys for demo).
# https://dashboard.stripe.com/test/apikeys
# Then optional: php artisan stripe:sync-plans
# Webhook: stripe listen --forward-to http://127.0.0.1:18080/api/webhooks/stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Stripe monthly Prices for Pro (€19) and Business (€40).
# Leave empty and run: php artisan stripe:sync-plans --currencies=eur,chf
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
# Regional prices — amounts should match EUR list × FX (see BILLING_FX_* / live ECB rates)
STRIPE_PRICE_PRO_MONTHLY_CHF=
STRIPE_PRICE_BUSINESS_MONTHLY_CHF=
STRIPE_PRICE_PRO_MONTHLY_GBP=
STRIPE_PRICE_BUSINESS_MONTHLY_GBP=
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_BUSINESS_MONTHLY_USD=
# Fallback FX when Frankfurter/ECB is unreachable (units per 1 EUR)
BILLING_FX_CHF=0.94
BILLING_FX_USD=1.08
BILLING_FX_GBP=0.86
# Complimentary Pro trial days (no card) after signup
BILLING_TRIAL_DAYS=7
BILLING_TRIAL_PLAN=pro
# Legacy yearly keys (unused — billing is monthly)
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

VITE_APP_NAME="${APP_NAME}"
